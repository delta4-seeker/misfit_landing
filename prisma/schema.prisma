generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ListingStatus {
  DRAFT
  LIVE
  HIDDEN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum WhatsAppRecordSource {
  LIVE
  IMPORT
}

enum WhatsAppConnectionStatus {
  NOT_CONFIGURED
  PAIRING
  CONNECTING
  CONNECTED
  RECONNECTING
  DISCONNECTED
  LOGGED_OUT
  ERROR
}

enum BlogStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                 String            @id @default(cuid())
  name               String?
  email              String?           @unique
  emailVerified      DateTime?
  image              String?
  fullName           String?
  phone              String?
  linkedinUrl        String?
  instagramHandle    String?
  profilePicture     String?
  profileCompleted   Boolean           @default(false)
  status             UserStatus        @default(ACTIVE)
  isAdmin            Boolean           @default(false)
  isSuperAdmin       Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  accounts           Account[]
  sessions           Session[]
  products           Product[]         @relation("ProductOwner")
  coFoundedProducts  Product[]         @relation("ProductCoFounders")
  productVotes       ProductVote[]
  productComments    ProductComment[]
  invitesAccepted    CoFounderInvite[] @relation("AcceptedInviteUser")
  galleryPhotos      GalleryPhoto[]
  blogPosts          BlogPost[]
  blogLikes          BlogLike[]
  blogComments       BlogComment[]
  auditLogs          AuditLog[]        @relation("AuditActor")
  whatsappIdentities WhatsAppMember[]

  @@index([status])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id              String            @id @default(cuid())
  ownerId         String
  owner           User              @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  coFounders      User[]            @relation("ProductCoFounders")
  categoryId      String
  category        Category          @relation(fields: [categoryId], references: [id])
  name            String
  slug            String            @unique
  companyName     String?
  websiteUrl      String
  linkedinUrl     String?
  instagramHandle String?
  founderType     String?
  tagline         String
  description     String
  logoUrl         String?
  foundedMonth    Int?
  foundedYear     Int?
  exclusive       Boolean           @default(false)
  featured        Boolean           @default(false)
  featuredOrder   Int               @default(0)
  status          ListingStatus     @default(DRAFT)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  invites         CoFounderInvite[]
  votes           ProductVote[]
  comments        ProductComment[]

  @@index([status, featured, featuredOrder])
  @@index([categoryId])
}

model ProductVote {
  productId String
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([productId, userId])
  @@index([userId])
}

model ProductComment {
  id        String   @id @default(cuid())
  productId String
  authorId  String
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([authorId])
}

model CoFounderInvite {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  email          String
  token          String       @unique @default(cuid())
  status         InviteStatus @default(PENDING)
  acceptedUserId String?
  acceptedUser   User?        @relation("AcceptedInviteUser", fields: [acceptedUserId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@unique([productId, email])
}

model Event {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  startsAt      DateTime
  venue         String
  description   String
  coverImageUrl String?
  lumaUrl       String
  capacity      Int?
  priceNpr      Decimal? @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startsAt])
}

model GalleryPhoto {
  id           String   @id @default(cuid())
  imageUrl     String
  thumbnailUrl String?
  uploaderId   String?
  uploader     User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model MediaAsset {
  id           String   @id @default(cuid())
  data         Bytes    @db.ByteA
  contentType  String
  size         Int
  checksum     String
  folder       String
  originalName String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  unsubscribeToken String   @unique @default(cuid())
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model SiteSettings {
  id                       Int      @id @default(1)
  applyFormUrl             String?
  instagramUrl             String?
  linkedinUrl              String?
  lumaCalendarUrl          String   @default("https://luma.com/user/misfitfounders")
  homepageLumaEventUrl     String?
  homepageLumaEventId      String?
  homepageLumaEventVisible Boolean  @default(false)
  contactEmail             String?
  galleryMaxUploadMb       Int      @default(8)
  updatedAt                DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String?
  targetId   String?
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model BlockedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model ActionRateLimit {
  id          String   @id
  action      String
  subjectHash String
  count       Int      @default(1)
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}

model BlogPost {
  id             String        @id @default(cuid())
  authorId       String?
  author         User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title          String
  slug           String        @unique
  kicker         String?
  excerpt        String
  body           String        @db.Text
  tags           String[]
  coverImageUrl  String?
  authorName     String
  status         BlogStatus    @default(DRAFT)
  readingMinutes Int           @default(1)
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  likes          BlogLike[]
  comments       BlogComment[]

  @@index([status, publishedAt])
  @@index([authorId, status, publishedAt])
}

model BlogLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String   @db.Text
  name      String
  role      String
  company   String
  photoUrl  String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model WhatsAppGroup {
  id            String                @id @default(cuid())
  externalId    String                @unique
  name          String
  enabled       Boolean               @default(true)
  lastMessageAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  messages      WhatsAppMessage[]
  importBatches WhatsAppImportBatch[]

  @@index([enabled])
}

model WhatsAppMember {
  id              String             @id @default(cuid())
  externalId      String             @unique
  displayName     String?
  phone           String?
  linkedUserId    String?
  linkedUser      User?              @relation(fields: [linkedUserId], references: [id], onDelete: SetNull)
  firstSeenAt     DateTime           @default(now())
  lastSeenAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  messages        WhatsAppMessage[]
  reactionsGiven  WhatsAppReaction[] @relation("WhatsAppReactionGiver")
  reactionsEarned WhatsAppReaction[] @relation("WhatsAppReactionRecipient")

  @@index([linkedUserId])
  @@index([lastSeenAt])
}

model WhatsAppMessage {
  id            String               @id @default(cuid())
  externalId    String
  groupId       String
  group         WhatsAppGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  authorId      String
  author        WhatsAppMember       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  importBatchId String?
  importBatch   WhatsAppImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  sentAt        DateTime
  kind          String               @default("text")
  source        WhatsAppRecordSource
  deletedAt     DateTime?
  createdAt     DateTime             @default(now())
  reactions     WhatsAppReaction[]

  @@unique([groupId, externalId])
  @@index([authorId, sentAt])
  @@index([groupId, sentAt])
  @@index([importBatchId])
}

model WhatsAppReaction {
  id          String               @id @default(cuid())
  messageId   String
  message     WhatsAppMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reactorId   String
  reactor     WhatsAppMember       @relation("WhatsAppReactionGiver", fields: [reactorId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   WhatsAppMember       @relation("WhatsAppReactionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  emoji       String
  reactedAt   DateTime
  removedAt   DateTime?
  source      WhatsAppRecordSource
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([messageId, reactorId])
  @@index([recipientId, reactedAt])
  @@index([reactorId, reactedAt])
}

model WhatsAppImportBatch {
  id               String            @id @default(cuid())
  groupId          String
  group            WhatsAppGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fileName         String?
  importedMessages Int               @default(0)
  skippedMessages  Int               @default(0)
  createdAt        DateTime          @default(now())
  messages         WhatsAppMessage[]

  @@index([createdAt])
}

model WhatsAppConnectionState {
  id                Int                      @id @default(1)
  status            WhatsAppConnectionStatus @default(NOT_CONFIGURED)
  accountExternalId String?
  displayName       String?
  lastConnectedAt   DateTime?
  lastEventAt       DateTime?
  lastError         String?
  updatedAt         DateTime                 @updatedAt
}

model WhatsAppAuthState {
  key        String   @id
  ciphertext Bytes    @db.ByteA
  iv         Bytes    @db.ByteA
  authTag    Bytes    @db.ByteA
  updatedAt  DateTime @updatedAt
}
