generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ListingStatus {
  DRAFT
  LIVE
  HIDDEN
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model User {
  id               String          @id @default(cuid())
  name             String?
  email            String?         @unique
  emailVerified    DateTime?
  image             String?
  fullName          String?
  phone             String?
  linkedinUrl       String?
  instagramHandle  String?
  profilePicture   String?
  profileCompleted Boolean         @default(false)
  status            UserStatus      @default(ACTIVE)
  isAdmin           Boolean         @default(false)
  isSuperAdmin      Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  accounts          Account[]
  sessions          Session[]
  products          Product[]       @relation("ProductOwner")
  coFoundedProducts Product[]       @relation("ProductCoFounders")
  productVotes      ProductVote[]
  productComments   ProductComment[]
  invitesAccepted   CoFounderInvite[] @relation("AcceptedInviteUser")
  galleryPhotos     GalleryPhoto[]
  auditLogs         AuditLog[]       @relation("AuditActor")

  @@index([status])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  sortOrder Int      @default(0)
  products Product[]
}

model Product {
  id               String          @id @default(cuid())
  ownerId          String
  owner            User            @relation("ProductOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  coFounders       User[]          @relation("ProductCoFounders")
  categoryId       String
  category         Category        @relation(fields: [categoryId], references: [id])
  name             String
  slug             String          @unique
  companyName      String?
  websiteUrl       String
  linkedinUrl      String?
  instagramHandle  String?
  founderType      String?
  tagline          String
  description      String
  logoUrl          String?
  foundedMonth     Int?
  foundedYear      Int?
  builtInNepal     Boolean         @default(true)
  exclusive        Boolean         @default(false)
  featured         Boolean         @default(false)
  featuredOrder    Int             @default(0)
  status           ListingStatus   @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  invites          CoFounderInvite[]
  votes            ProductVote[]
  comments         ProductComment[]

  @@index([status, featured, featuredOrder])
  @@index([categoryId])
}

model ProductVote {
  productId String
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([productId, userId])
  @@index([userId])
}

model ProductComment {
  id        String   @id @default(cuid())
  productId String
  authorId  String
  body      String   @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([authorId])
}

model CoFounderInvite {
  id             String       @id @default(cuid())
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  email          String
  token          String       @unique @default(cuid())
  status         InviteStatus @default(PENDING)
  acceptedUserId String?
  acceptedUser   User?        @relation("AcceptedInviteUser", fields: [acceptedUserId], references: [id])
  expiresAt      DateTime
  createdAt      DateTime     @default(now())

  @@unique([productId, email])
}

model Event {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  startsAt     DateTime
  venue        String
  description  String
  coverImageUrl String?
  lumaUrl      String
  capacity     Int?
  priceNpr     Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([startsAt])
}

model GalleryPhoto {
  id           String   @id @default(cuid())
  imageUrl     String
  thumbnailUrl String?
  caption      String?
  uploaderId   String?
  uploader     User?    @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model NewsletterSubscriber {
  id             String   @id @default(cuid())
  email          String   @unique
  unsubscribeToken String @unique @default(cuid())
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model SiteSettings {
  id                 Int      @id @default(1)
  applyFormUrl       String?
  instagramUrl       String?
  linkedinUrl        String?
  contactEmail       String?
  galleryMaxUploadMb Int      @default(8)
  updatedAt          DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  targetType String?
  targetId  String?
  changes   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model BlockedEmail {
  id        String   @id @default(cuid())
  email     String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model ActionRateLimit {
  id          String   @id
  action      String
  subjectHash String
  count       Int      @default(1)
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@index([expiresAt])
}
