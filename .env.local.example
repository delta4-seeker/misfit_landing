# Web app
AUTH_URL=http://localhost:3000
# Keep localhost as the canonical local host. Do not mix it with 127.0.0.1 during OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32

# Google OAuth
# Local callback: http://localhost:3000/api/auth/callback/google
# Production callback: https://misfitfoundersclub.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase Postgres. For local development, the project reference and database
# password are enough; the app builds TLS transaction and session pooler URLs.
SUPABASE_PROJECT_REF=adjjtejmrmzjqoasjhtp
SUPABASE_POOLER_HOST=aws-0-ap-northeast-1.pooler.supabase.com
SUPABASE_DB_PASSWORD=

# For production, use the transaction pooler (port 6543) for the deployed app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1
# Use the session pooler (port 5432) for migrations and data imports.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Seeded owner account
SEED_ADMIN_EMAIL=9165prashant@gmail.com
